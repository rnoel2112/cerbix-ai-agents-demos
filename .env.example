# Cerbix live validation — environment template.
# Copy to `.env.local` (gitignored) and fill in. NEVER commit real keys.
#
#   cp clientAI/.env.example clientAI/.env.local
#   # then edit clientAI/.env.local
#
# ── Cerbix live endpoints (already correct — no need to change) ──
CERBIX_CONTROL_URL=https://agentgate-control-ykaskf6txa-uc.a.run.app
CERBIX_AUDIT_URL=https://agentgate-audit-ykaskf6txa-uc.a.run.app
CERBIX_PROXY_URL=https://agentgate-proxy-ykaskf6txa-uc.a.run.app

# ── Customer org + API key (YOU generate these) ──
# 1. Log in at http://localhost:3000  (Firebase — localhost is now authorized)
# 2. Create the org (e.g. "NewBank")    → copy its org id here
# 3. Settings → API Keys → Create        → copy the key here (shown once)
CERBIX_ORG_ID=
CERBIX_API_KEY=

# ── LLM provider keys (for real agent calls; fill the ones you'll test) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
